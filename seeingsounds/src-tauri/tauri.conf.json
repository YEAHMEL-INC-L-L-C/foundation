{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seeing Sounds",
  "version": "1.0.0",
  "identifier": "com.yeahmel.seeingsounds",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Seeing Sounds",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Music",
    "shortDescription": "See exactly what you hear.",
    "publisher": "YEAHMEL INC LLC",
    "copyright": "Copyright © 2026 YEAHMEL INC LLC. Licensed under the Apache License 2.0.",
    "license": "Apache-2.0"
  }
}
